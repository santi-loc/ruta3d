{
  "name": "ruta3d",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "refresh:catalog": "node scripts/refresh-catalog.mjs && pnpm run test",
    "scrape:erexit3d": "node scripts/scrape-erexit3d.mjs",
    "scrape:erexit3d:sample": "EREXIT_MAX_PAGES=1 node scripts/scrape-erexit3d.mjs --output=data/erexit3d-products.sample.json",
    "scrape:laboratorio3d": "node scripts/scrape-laboratorio3d.mjs",
    "scrape:laboratorio3d:sample": "LAB3D_MAX_PAGES=1 node scripts/scrape-laboratorio3d.mjs --output=data/laboratorio3d-products.sample.json",
    "scrape:lefasoc": "node scripts/scrape-lefasoc.mjs",
    "scrape:lefasoc:sample": "LEFASOC_MAX_PAGES=1 node scripts/scrape-lefasoc.mjs --output=data/lefasoc-products.sample.json",
    "scrape:kimera3d": "node scripts/scrape-kimera3d.mjs",
    "scrape:tp3d": "node scripts/scrape-tp3d.mjs",
    "scrape:tp3d:sample": "TP3D_MAX_PAGES=1 node scripts/scrape-tp3d.mjs --output=data/tp3d-products.sample.json",
    "scrape:proyectocolor": "node scripts/scrape-proyectocolor.mjs",
    "scrape:proyectocolor:sample": "PROYECTO_COLOR_MAX_PAGES=1 node scripts/scrape-proyectocolor.mjs --output=data/proyectocolor-products.sample.json",
    "scrape:all": "node scripts/scrape-all.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.6",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "type": "module"
}
